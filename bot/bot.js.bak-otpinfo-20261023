  if (!flash) {
    const text = `${divider('sparkle')}\n\n${E.bolt} <b>FLASH SALE</b>\n${DIV}\n\n${E.clock} Belum ada flash sale aktif.\nNantikan promo spesial berikutnya! ${E.fire}\n\n${divider('sparkle')}`;
