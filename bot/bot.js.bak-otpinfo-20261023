      const t = store.db.prepare('SELECT * FROM tickets WHERE id=?').get(ticketId);
      inputState.delete(uid);
      if (!t) return ctx.reply('Ticket tidak ditemukan.');
      store.db.prepare('INSERT INTO ticket_msgs(ticket_id,from_admin,text) VALUES(?,?,?)').run(ticketId, 1, txt);
      await ctx.telegram.sendMessage(t.user_id, `💬 <b>Balasan Admin:</b>\n\n${esc(txt)}`, { parse_mode: 'HTML', ...backMenu }).catch(() => {});
      return ctx.reply('✅ Balasan terkirim.');
    }
    if (st.mode === 'review') {
      const review = txt.trim() === '/skip' ? '' : txt.trim().slice(0, 500);
      store.db.prepare('UPDATE orders SET review=? WHERE order_id=? AND user_id=?').run(review, st.data.orderId, uid);
      inputState.delete(uid);
      return ctx.reply(`${divider('sparkle')}\n\n${E.check} <b>Terima kasih atas testimoni Anda!</b> ${E.heart}\n\n${review ? `${E.heart} <i>"${esc(review)}"</i>` : `${E.pray} Masukan Anda sangat berharga.`}\n\nSampai jumpa di order berikutnya! ${E.wink}\n\n${divider('sparkle')}`,
        { parse_mode: 'HTML', ...Markup.inlineKeyboard([
          [Markup.button.callback('🛍️ Belanja Lagi', 'cats')],
          [Markup.button.callback('‹ Menu Utama', 'menu')],
        ]) });
    }
  });

  // payment poller
  async function pollPayments() {
    for (const o of store.pendingOrders()) {
      try {
        if (o.expired_at && new Date(o.expired_at) < new Date()) { store.setOrderStatus(o.order_id, 'expired'); qrisMarkClosed(bot, o, `${E.cross} <b>PEMBAYARAN KEDALUARSA</b>`, 'QR tidak berlaku lagi. Buat order baru bila masih berminat.'); continue; }
        if (!o.qris_url) continue; // order via saldo, belum pakai QR
        const d = await qris.status(o.order_id);
        const st = String(d.status || '').toUpperCase();
        if (st === 'PAID' || st === 'SUCCESS' || st === 'SETTLED') await fulfillOrder(bot, o.order_id, d.paid_at);
      } catch (e) { /* retry next round */ }
    }
    for (const t of store.walletPendingTopups()) {
      try {
        if (t.expired_at && new Date(t.expired_at) < new Date()) {
          store.walletSetTopupStatus(t.topup_id, 'expired');
          topupMarkClosed(bot, t, `${E.cross} <b>ISI SALDO KEDALUARSA</b>`, 'QR tidak berlaku lagi. Buat topup baru bila masih berminat.');
          continue;
        }
        const d = await qris.status(t.topup_id);
        const st = String(d.status || '').toUpperCase();
        if (st === 'PAID' || st === 'SUCCESS' || st === 'SETTLED') {
          if (store.walletCreditTopup(t.topup_id)) {
            topupMarkClosed(bot, t, `${E.check} <b>ISI SALDO BERHASIL</b>`, `Saldo bertambah ${rp(t.amount)}.`);
            bot.telegram.sendMessage(t.user_id, `${E.money} <b>Isi saldo ${rp(t.amount)} BERHASIL!</b>\n\n<i>Saldo siap dipakai belanja.</i>\n\n${divider('sparkle')}`, { parse_mode: 'HTML', ...Markup.inlineKeyboard([[Markup.button.callback('💰 Lihat Saldo', 'menu_saldo')], [Markup.button.callback('‹ Menu Utama', 'menu')]]) }).catch(() => {});
          }
        }
      } catch (e) { /* retry next round */ }
    }
  }
  setInterval(pollPayments, 30000);

  // bangkitkan ulang retry VCC yang kehilangan timer (mis. pm2 restart)
  const reviveVcc = () => {
    try {
      const rows = store.db.prepare("SELECT * FROM orders WHERE status='paid' AND senna_state IN ('pending_create','created') AND created_at > datetime('now','-24 hours')").all();
      for (const o of rows) {
        const items = store.db.prepare('SELECT * FROM order_items WHERE order_id=?').all(o.order_id);
        for (let idx = 0; idx < items.length; idx++) {
          const it = items[idx];
          const p = store.getProduct(it.product_id);
          if (!p || p.type !== 'vcc') continue;
          const exId = `${o.order_id}${idxSuffix(idx)}`.slice(0, 80);
          const hasCard = String(o.delivered_content || '').includes('💳 <b>Nomor');
          if ((o.senna_state === 'created') && hasCard) { store.markVccState(o.order_id, 'done'); continue; }
          console.log(`[vcc-revive] ${o.order_id} state=${o.senna_state}`);
          if (o.senna_state === 'pending_create') scheduleVccCreateRetry(bot, o.order_id, exId, it, p, (p.description || p.name || 'VCC').slice(0, 200));
          else scheduleVccRetry(bot, o.order_id, exId, it);
        }
      }
    } catch (e) { console.error('[vcc-revive]', e.message); }
  };
  setTimeout(reviveVcc, 10000);

  // link bot resmi (refresh username via getMe)
  bot.telegram.getMe().then((me) => { SHOP_BOT_LINK = 'https://t.me/' + me.username; }).catch(() => {});

  // iklan rotasi otomatis ke channel (interval via setting ads_interval_min, 0=off)
  let adsCounter = 0;
  setInterval(async () => {
    try {
      adsCounter++;
      const iv = Number(store.getSetting('ads_interval_min', '240'));
      if (!iv || iv <= 0 || adsCounter < iv) return;
      adsCounter = 0;
      if (!notify.target()) return;
      const prods = store.allProducts().filter((p) => p.is_active === 1);
      if (!prods.length) return;
      const picks = [];
      for (let k = 0; k < Math.min(3, prods.length); k++) picks.push(prods[(adsIdx + k) % prods.length]);
      adsIdx = (adsIdx + 3) % prods.length;
      const lines = picks.map((p) => {
        const stok = p.stock_n > 0 ? `${p.stock_n} stok siap` : (p.type === 'vcc' ? 'terbit otomatis' : 'order via admin');
        return `${E.card} <b>${esc(p.name)}</b> ─ <b>${rp(p.price)}</b>\n<i>   ${esc(p.cat_name || '')} · ${stok}</i>`;
      });
      let photo = null;
      const p0 = picks[0];
      if (p0.photo_url) photo = /^https?:/i.test(p0.photo_url) ? p0.photo_url : (process.env.PUBLIC_URL ? process.env.PUBLIC_URL.replace(/\/+$/, '') + p0.photo_url : null);
      notify.notify(`${E.bag} <b>${esc(SHOP())}</b> — ${esc(TAGLINE() || 'Belanja mudah 24 jam')}

${lines.join('\n\n')}

${E.arrow} Order langsung di bot: ${shopBotLink()}
${E.info} Pembayaran QRIS instan, saldo wallet juga bisa`, photo || undefined);
    } catch (e) { console.error('[ads]', e.message); }
  }, 60000);

// command menu
bot.telegram.setMyCommands([
  { command: 'start', description: 'Menu utama' },
  { command: 'katalog', description: 'Lihat katalog produk' },
  { command: 'cari', description: 'Cari produk' },
  { command: 'keranjang', description: 'Lihat keranjang' },
  { command: 'pesanan', description: 'Riwayat pesanan' },
  { command: 'bantuan', description: 'Hubungi admin' },
]).catch(() => {});

  // auto-deteksi chat saat bot ditambahkan ke channel/grup (lihat log untuk chat id)
  bot.on('my_chat_member', (ctx) => {
    try {
      const c = ctx.myChatMember.chat;
      const me = ctx.myChatMember.new_chat_member || {};
      console.log(`[chat-detect] type=${c.type} id=${c.id} title=${c.title || c.first_name || ''} status=${me.status}`);
    } catch (e) {}
  });

  return bot;
}

module.exports = { setupBot, fulfillOrder };
