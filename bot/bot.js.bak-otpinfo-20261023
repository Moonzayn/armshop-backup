    if (!p || !p.is_active) continue;
    items.push({ p, fp });
  }
  const pages = Math.max(1, Math.ceil(items.length / FLASH_PAGE));
  page = Math.min(Math.max(1, Number(page) || 1), pages);
  const slice = items.slice((page - 1) * FLASH_PAGE, page * FLASH_PAGE);
  const lines = [
    divider('sparkle'),
    '',
    `   ${E.bolt}${E.fire} <b>FLASH SALE</b> ${E.fire}${E.bolt}`,
    '',
    `${E.clock} Berakhir dalam: <b>${fmtCountdown(remain)}</b>`,
    `${progressBar(1, 1, 20)}`,
    '',
    divider('dot'),
  ];
  const rows = [];
  for (const { p, fp } of slice) {
    const disc = discountPct(p.price, fp);
    lines.push(box([
      `${E.package} <b>${esc(p.name)}</b>`,
      `${E.cross} <s>${rp(p.price)}</s>`,
      `${E.bolt} <b>${rp(fp)}</b> ${disc ? `(-${disc}%)` : ''}`,
      `${E.fire} ${E.tag} Hemat ${rp(p.price - fp)}`,
      `${E.package} Sisa stok: <b>${p.type === 'digital' ? p.stock_n : (p.type === 'vcc' ? (p.senna_stok == null ? 'diberbitkan otomatis' : (p.senna_stok > 0 ? p.senna_stok : 'menunggu supplier — terbit otomatis')) : 'terbatas')}</b>`,
    ]));
    rows.push([Markup.button.callback(`⚡ ${p.name} — ${rp(fp)}`, `flashbuy:${p.id}`)]);
  }
  if (!items.length) {
    lines.push(`${E.warn} Produk flash sale sudah tidak tersedia.`);
  }
  if (pages > 1) lines.push('', `${E.package} Halaman <b>${page}</b> dari <b>${pages}</b>`);
  lines.push('', `${E.warn} <b>Stok sangat terbatas!</b> Buruan sebelum kehabisan! ${E.rocket}`, '', divider('sparkle'));
  rows.push(...pageNav('menu_flash', page, pages));
  rows.push([Markup.button.callback('🔄 Refresh', `menu_flash:${page}`)]);
  rows.push([Markup.button.callback('‹ Menu Utama', 'menu')]);
  const text = lines.join('\n');
  try { await ctx.editMessageText(text, { parse_mode: 'HTML', ...Markup.inlineKeyboard(rows) }); }
  catch (e) { return ctx.reply(text, { parse_mode: 'HTML', ...Markup.inlineKeyboard(rows) }); }
}

