}

async function createOrderFromCart(ctx, singleProd = null, singleQty = 1, priceOverride = null) {
  if (!store.tncOk(ctx.from.id)) {
    await ctx.answerCbQuery('Setujui SNK dulu ya ✅').catch(() => {});
    return showSnk(ctx, true);
  }
  const uid = ctx.from.id;
  // ---- gate channel: wajib join channel notif dulu ----
  if (store.getSetting('gate_checkout', '1') === '1' && !ADMIN_IDS.includes(uid)) {
    const isMem = await channelMember(ctx.telegram, uid);
    if (!isMem) {
      gatePending.set(uid, { singleProd: singleProd || null, singleQty: singleQty || 1 });
      const gateText = '📢 <b>SATU LANGKAH LAGI!</b>\n\nBiar nggak ketinggalan <b>info restock, flash sale, & promo terbaru</b>, join dulu <b>Channel La Cukai</b> ya — semua info penting selalu diumumkan di sana lebih dulu. 🔔\n\nSudah join? Ketuk tombol di bawah ini, checkout kamu langsung lanjut. 👇';
      const gateKb = Markup.inlineKeyboard([
        [Markup.button.url('📢 Join Channel La Cukai', GATE_CH_URL())],
        [Markup.button.callback('✅ Sudah Join — Lanjut Checkout', 'gate_check')],
        [Markup.button.callback('‹ Menu Utama', 'menu')],
      ]);
      await ctx.answerCbQuery('Join channel dulu ya 📢').catch(() => {});
      const edited = await ctx.editMessageText(gateText, { parse_mode: 'HTML', ...gateKb }).then(() => true).catch(() => false);
      if (!edited) await ctx.reply(gateText, { parse_mode: 'HTML', ...gateKb }).catch(() => {});
      return;
    }
  }
  const items = [];
  if (singleProd) {
    const p = store.getProduct(singleProd);
    if (!p) return ctx.answerCbQuery('Produk tidak ditemukan');
    items.push({ p, qty: singleQty, unit: priceOverride || flashPriceOf(singleProd) || p.price });
  } else {
    for (const [pid, qty] of getCart(uid)) {
      const p = store.getProduct(pid);
      if (p) items.push({ p, qty, unit: flashPriceOf(pid) || p.price });
    }
    if (!items.length) return ctx.answerCbQuery('Keranjang kosong');
  }
  // stock check produk digital (VCC selalu terbuka — kartu diterbitkan otomatis via supplier)
  for (const { p, qty } of items) {
    if (p.type === 'digital' && p.stock_n < qty) {
      await ctx.answerCbQuery(`Stok ${p.name} kurang (sisa ${p.stock_n})`, true).catch(() => {});
      await vccBlock(ctx, p, qty, `${E.warn} <b>Stok ${esc(p.name)} sudah habis</b>`, 'Stok sedang kosong, coba lagi nanti ya.');
      return;
    }
  }
  let amount = items.reduce((a, { p, qty, unit }) => a + unit * qty, 0);
  // voucher
  const st = inputState.get(uid);
  let discount = 0, voucherCode = '';
  if (st && st.mode === 'voucher_ok' && st.data) {
    const v = store.getVoucher(st.data.code);
    if (v && (!v.quota || v.used < v.quota) && amount >= (v.min_amount || 0)) {
      discount = v.kind === 'percent' ? Math.round(amount * v.value / 100) : Math.min(v.value, amount);
      voucherCode = v.code;
    }
  }
  const total = Math.max(amount - discount, 1000);
  const orderId = makeOrderId();
  const prodName = items.length === 1 ? `${items[0].p.name} ×${items[0].qty}` : `${items.length} produk`;
  const keterangan = `Order ${orderId} - ${SHOP()}`.slice(0, 60);
  const publicUrl = (process.env.PUBLIC_URL || '').replace(/\/+$/, '');

  // ---- jalur bayar pakai SALDO (jika saldo mencukupi) ----
  const bal = store.walletGet(uid);
  if (bal >= total) {
    const expiredAtS = new Date(Date.now() + EXP_MIN * 60000).toISOString();
    store.db.prepare(`INSERT INTO orders(order_id,user_id,product_id,product_name,qty,amount,discount,total,voucher_code,qris_image,qris_url,expired_at,signature)
      VALUES(?,?,?,?,?,?,?,?,?,?,?,?,?)`).run(orderId, uid, items[0].p.id, prodName, items.reduce((a, i) => a + i.qty, 0),
      amount, discount, total, voucherCode, '', '', expiredAtS, '');
    items.forEach(({ p, qty, unit }) => store.db.prepare('INSERT INTO order_items(order_id,product_id,product_name,qty,price) VALUES(?,?,?,?,?)').run(orderId, p.id, p.name, qty, unit));
    if (voucherCode) store.useVoucher(voucherCode);
    if (!singleProd) carts.set(uid, new Map());
    inputState.delete(uid);
    const text = `${divider('sparkle')}\n\n   💰 <b>PESANAN SIAP</b>\n\n${box([
      `${E.ticket} No. Order ─ <code>${orderId}</code>`,
      `${E.cart} Produk ─ ${esc(prodName)}`,
      `${E.money} Total Bayar ─ <b>${rp(total)}</b>`,
    ])}\n\n${E.gem} Saldo kamu <b>${rp(bal)}</b> ─ cukup untuk membayar order ini.\n\n${divider('sparkle')}`;
    const kb = Markup.inlineKeyboard([
      [Markup.button.callback(`✅ Bayar dengan Saldo (${rp(total)})`, `saldopay:${orderId}`)],
      [Markup.button.callback('💳 Bayar via QRIS', `qrinstead:${orderId}`)],
      [Markup.button.callback('❌ Batalkan Pesanan', `cancel:${orderId}`)],
    ]);
    try { await ctx.editMessageText(text, { parse_mode: 'HTML', ...kb }); }
    catch (e) { return ctx.reply(text, { parse_mode: 'HTML', ...kb }); }
    return;
  }

  let qd;
  try {
    qd = await qris.create({
      orderId, amount: total, keterangan,
      callbackUrl: publicUrl ? `${publicUrl}/webhook/qris` : '',
    });
  }
  catch (e) { console.error('[QRIS create]', e.message); await ctx.reply('❌ Gagal membuat pembayaran QRIS. Coba lagi sebentar.'); return; }

  const expiredAt = qd.expired_at || new Date(Date.now() + EXP_MIN * 60000).toISOString();
  store.db.prepare(`INSERT INTO orders(order_id,user_id,product_id,product_name,qty,amount,discount,total,voucher_code,qris_image,qris_url,expired_at,signature)
    VALUES(?,?,?,?,?,?,?,?,?,?,?,?,?)`).run(orderId, uid, items[0].p.id, prodName, items.reduce((a, i) => a + i.qty, 0),
    amount, discount, Number(qd.total_amount || total), voucherCode, '', qd.qris_url || '', expiredAt, qd.signature || '');
  const insItem = store.db.prepare('INSERT INTO order_items(order_id,product_id,product_name,qty,price) VALUES(?,?,?,?,?)');
  items.forEach(({ p, qty, unit }) => insItem.run(orderId, p.id, p.name, qty, unit));
  if (voucherCode) store.useVoucher(voucherCode);
  if (!singleProd) carts.set(uid, new Map());
  inputState.delete(uid);

  await sendQrisMessage(ctx, store.getOrder(orderId), qd);

  // notify admins
  const u = ctx.from;
  for (const aid of ADMIN_IDS) {
    ctx.telegram.sendMessage(aid, `${E.bell} <b>Order Baru</b>\n\n${box([
      `${E.ticket} <code>${orderId}</code>`,
      `${E.user} ${esc(u.first_name)} (@${esc(u.username || '-')})`,
      `${E.cart} ${esc(prodName)}`,
      `${E.money} ${rp(qd.total_amount || total)}`,
    ])}`, { parse_mode: 'HTML' }).catch(() => {});
  }
}

// ---- Fulfill satu item VCC via Senn AutoOrder ----
const cardHtml = (cards) =>
  cards.map(s => {
    const c = senna.parseCard(s);
    return `💳 <b>Nomor</b> ─ <code>${esc(c.number || c.raw)}</code>\n🗓️ <b>Berlaku</b> ─ <code>${esc(c.exp)}</code>\n🔐 <b>CVV</b> ─ <code>${esc(c.cvv)}</code>`;
  }).join('\n\n');

const idxSuffix = (idx) => (idx === 0 ? '' : `-v${idx}`);

async function fulfillVccItem(bot, orderId, idx, it, p) {
  const sennaId = p.senna_product_id;
  const label = `<b>${esc(it.product_name)} ×${it.qty}</b>`;
  const adminBase = `${E.card} <b>VCC ORDER</b>\n${box([
    `${E.ticket} <code>${orderId}</code>`,
    `${E.cart} ${esc(it.product_name)} ×${it.qty}`,
  ])}\n`;
  if (!sennaId || !senna.enabled()) {
    return {
      userText: `${label}\n⚠️ Sistem VCC sedang gangguan — admin akan menghubungi Anda.`,
      adminNote: `${adminBase}${E.warn} produk tidak ter-mapping ke supplier (senna_product_id kosong)`,
    };
  }
  const externalId = `${orderId}${idxSuffix(idx)}`.slice(0, 80);
  const qty = Math.min(Math.max(1, it.qty), 100);
  const purpose = (p.description || p.name || 'VCC').slice(0, 200);

  try {
    await senna.createOrder(externalId, sennaId, { quantity: qty, customPurpose: purpose, saleAmount: it.price * it.qty });
  } catch (e) {
    const retriable = e.code === 'insufficient_deposit' || e.code === 'out_of_stock' || /fetch|network|timeout|ECON|ENOT/i.test(String(e.message));
    if (!retriable) {
      return {
        userText: `${label}\n⚠️ Penerbitan kartu gagal (${esc(e.code || 'error')}). Admin akan menghubungi Anda.`,
        adminNote: `${adminBase}${E.cross} createOrder gagal (tidak bisa diretrial): <code>${esc(e.message)}</code>`,
      };
    }
    // dana pembeli sudah masuk — kartu akan diterbitkan otomatis begitu supplier siap
    store.markVccState(orderId, 'pending_create');
    // harga supplier berasal live dari katalog (bisa berubah sewaktu-waktu)
    let unitPrice = 0;
    try { const sp = await senna.findProduct(sennaId); unitPrice = Number(sp && sp.price) || 0; } catch (e) {}
    const needed = e.code === 'insufficient_deposit' ? qty * (unitPrice || 2000) : 0;
    const adminDetail = e.code === 'insufficient_deposit'
      ? `${E.money} Deposit supplier kosong — top up <b>minimal ${rp(needed)}</b> di @vccsenna_bot agar order <code>${orderId}</code> bisa terbit`
      : e.code === 'out_of_stock'
        ? `${E.warn} Stok supplier habis — kartu terbit otomatis saat stok kembali`
        : `${E.warn} Server supplier tidak merespons saat checkout`;
    scheduleVccCreateRetry(bot, orderId, externalId, it, p, purpose);
    return {
      userText: `${label}\n✅ Pembayaran diterima.\n⚡ Kartu akan <b>diterbitkan otomatis</b> — nomor, masa berlaku, dan CVV dikirim langsung ke chat ini (biasanya cepat). Bila melebihi 24 jam, hubungi admin dan dana Anda dikembalikan penuh.`,
      adminNote: `${adminBase}${adminDetail}${e.code === 'insufficient_deposit' ? `\n🔔 Retry otomatis tiap 5 menit, maksimal 24 jam.` : '\n🔔 Retry otomatis berjalan.'}`,
    };
  }

  store.markVccState(orderId, 'created');
  const res = await senna.waitForDelivery(externalId);
  if (res.status === 'COMPLETED' && res.items && res.items.length) {
    store.markVccState(orderId, 'done');
    return { userText: `${label}\n${cardHtml(res.items)}` };
  }
  if (res.status === 'FAILED') {
    store.markVccState(orderId, 'failed');
    const ord = store.getOrder(orderId);
    if (ord) await refundToWallet(bot, orderId, externalId, ord.user_id, Math.round(Number(it.price) * it.qty), 'Penerbitan kartu gagal di supplier');
    return {
      userText: `${label}\n⚠️ Penerbitan kartu gagal di supplier.\n💸 Dana <b>${rp(Math.round(Number(it.price) * it.qty))}</b> sudah dikembalikan ke <b>saldo</b> kamu — bisa dipakai belanja langsung.`,
      adminNote: `${adminBase}${E.cross} Status <b>FAILED</b>: <code>${esc(res.error)}</code> (refund otomatis ke wallet)`,
    };
  }
  // PENDING / PROCESSING melewati window polling — jadwalkan pengecekan ulang otomatis
  scheduleVccRetry(bot, orderId, externalId, it);
  return {
    userText: `${label}\n⚡ Kartu sedang diterbitkan oleh supplier — data akan dikirim otomatis. Kalau lebih dari 30 menit, hubungi admin.`,
    adminNote: `${adminBase}${E.clock} Masih <b>${esc(res.status)}</b> — retry otomatis berjalan.`,
  };
}

// cek ulang berkala 1x/menit hingga 30x, kartu dikirim langsung ke pembeli saat COMPLETED
function scheduleVccRetry(bot, orderId, externalId, it) {
  const maxAttempts = 30;
  let attempts = 0;
  const o = store.getOrder(orderId);
  const tick = async () => {
    attempts++;
    const cur = store.getOrder(orderId);
    if (!cur || cur.status === 'cancelled' || cur.status === 'expired') return;
    try {
      const res = await senna.waitForDelivery(externalId, { maxMs: 5000 });
      if (res.status === 'COMPLETED') {
        store.markVccState(orderId, 'done');
        const body = `<b>${esc(it.product_name)} ×${it.qty}</b>\n${cardHtml(res.items)}`;
        store.db.prepare(`UPDATE orders SET delivered_content = CASE WHEN delivered_content IS NULL OR delivered_content='' THEN ? ELSE delivered_content || char(10) || ? END WHERE order_id=?`).run(body, body, orderId);
        if (o) bot.telegram.sendMessage(o.user_id, `✨ <b>KARTU ANDA SUDAH TERBIT</b>\n\n${E.ticket} No. Order ─ <code>${esc(orderId)}</code>\n\n${body}`, { parse_mode: 'HTML' }).catch(() => {});
        for (const aid of ADMIN_IDS) bot.telegram.sendMessage(aid, `${E.check} VCC <code>${orderId}</code> terbit sukses (retry otomatis).`, { parse_mode: 'HTML' }).catch(() => {});
        return;
      }
      if (res.status === 'FAILED') {
        store.markVccState(orderId, 'failed');
        if (o) await refundToWallet(bot, orderId, externalId, o.user_id, it.price * it.qty, 'Penerbitan kartu gagal di supplier');
        for (const aid of ADMIN_IDS) bot.telegram.sendMessage(aid, `${E.cross} VCC <code>${orderId}</code> FAILED: <code>${esc(res.error)}</code> — refund otomatis ke wallet`, { parse_mode: 'HTML' }).catch(() => {});
        return;
      }
    } catch (e) {}
    if (attempts < maxAttempts) setTimeout(tick, 60000);
  };
  setTimeout(tick, 60000);
}

// order gagal dibuat di supplier (deposit/stok kosong) — coba buat ulang tiap 5 menit maks 24 jam
function scheduleVccCreateRetry(bot, orderId, externalId, it, p, purpose) {
  const maxAttempts = 288; // 5 menit x 288 = 24 jam
  const sennaId = p.senna_product_id;
  const qty = Math.min(Math.max(1, it.qty), 100);
  const label = `<b>${esc(it.product_name)} ×${it.qty}</b>`;
  let attempts = 0;
  const o = store.getOrder(orderId);
  const finish = async (res) => {
    store.markVccState(orderId, 'done');
    const body = `${label}\n${cardHtml(res.items)}`;
    store.db.prepare(`UPDATE orders SET delivered_content = CASE WHEN delivered_content IS NULL OR delivered_content='' THEN ? ELSE delivered_content || char(10) || ? END WHERE order_id=?`).run(body, body, orderId);
    if (o) bot.telegram.sendMessage(o.user_id, `✨ <b>KARTU ANDA SUDAH TERBIT</b>\n\n${E.ticket} No. Order ─ <code>${esc(orderId)}</code>\n\n${body}`, { parse_mode: 'HTML' }).catch(() => {});
    for (const aid of ADMIN_IDS) bot.telegram.sendMessage(aid, `${E.check} VCC <code>${orderId}</code> akhirnya terbit (retry deposit).`, { parse_mode: 'HTML' }).catch(() => {});
  };
  const tick = async () => {
    attempts++;
    const cur = store.getOrder(orderId);
    if (!cur || cur.status === 'cancelled' || cur.status === 'expired') return;
    try {
      await senna.createOrder(externalId, sennaId, { quantity: qty, customPurpose: purpose, saleAmount: it.price * it.qty });
      store.markVccState(orderId, 'created');
      const res = await senna.waitForDelivery(externalId);
      if (res.status === 'COMPLETED' && res.items && res.items.length) return finish(res);
      if (res.status === 'FAILED') {
        store.markVccState(orderId, 'failed');
        if (o) await refundToWallet(bot, orderId, externalId, o.user_id, it.price * it.qty, `Penerbitan gagal di supplier (${res.error})`);
        for (const aid of ADMIN_IDS) bot.telegram.sendMessage(aid, `${E.cross} VCC <code>${orderId}</code> FAILED: <code>${esc(res.error)}</code> — refund otomatis ke wallet`, { parse_mode: 'HTML' }).catch(() => {});
        return;
      }
    } catch (e) {
      // masih gagal (deposit/stok belum ready) — lanjut jadwal
      if (e.code && !['insufficient_deposit', 'out_of_stock', 'supplier_rate_limited'].includes(e.code)) {
        for (const aid of ADMIN_IDS) bot.telegram.sendMessage(aid, `${E.warn} VCC <code>${orderId}</code> retry gagal berulang: <code>${esc(e.message)}</code> — periksa manual`, { parse_mode: 'HTML' }).catch(() => {});
        return;
      }
    }
    if (attempts < maxAttempts) setTimeout(tick, 5 * 60 * 1000);
    else {
      store.markVccState(orderId, 'failed');
      if (o) await refundToWallet(bot, orderId, externalId, o.user_id, it.price * it.qty, 'Kartu tidak terbit dalam 24 jam');
      for (const aid of ADMIN_IDS) bot.telegram.sendMessage(aid, `${E.warn} VCC <code>${orderId}</code> lewat 24 jam — refund otomatis ke wallet sudah berjalan.`, { parse_mode: 'HTML' }).catch(() => {});
    }
  };
  setTimeout(tick, 5 * 60 * 1000);
}

async function fulfillOrder(bot, orderId, paidAt) {
  const o = store.getOrder(orderId);
  if (!o || o.status === 'paid') return false;
  const items = store.db.prepare('SELECT * FROM order_items WHERE order_id=?').all(orderId);
  const parts = [];
  qrisMarkClosed(bot, o, `${E.check} <b>PEMBAYARAN DITERIMA</b>`, 'Terima kasih — order diproses.');
  for (let idx = 0; idx < items.length; idx++) {
    const it = items[idx];
    const p = store.getProduct(it.product_id);
    if (p && p.type === 'vcc') {
      const { userText, adminNote } = await fulfillVccItem(bot, orderId, idx, it, p);
      parts.push(userText);
      if (adminNote) for (const aid of ADMIN_IDS) bot.telegram.sendMessage(aid, adminNote, { parse_mode: 'HTML' }).catch(() => {});
    } else if (p && p.type === 'digital') {
      const codes = store.claimStock(it.product_id, it.qty, orderId);
      if (codes && codes.length) parts.push(`<b>${esc(it.product_name)} ×${it.qty}</b>\n${codes.map(c => `<code>${esc(c)}</code>`).join('\n')}`);
      else parts.push(`<b>${esc(it.product_name)} ×${it.qty}</b>\n⚠️ Stok otomatis kosong — admin akan kirim manual.`);
    } else {
      parts.push(`<b>${esc(it.product_name)} ×${it.qty}</b>\n📦 Produk layanan — tim kami akan segera memproses.`);
    }
  }
  const delivered = parts.join('\n\n');
  store.setOrderStatus(orderId, 'paid', { paid_at: paidAt, delivered_content: delivered });

  // invoice ke channel
  const buyerRow = store.db.prepare('SELECT first_name, username FROM users WHERE id=?').get(o.user_id);
  notify.announceInvoice({
    orderId,
    buyer: (buyerRow && (buyerRow.first_name || buyerRow.username)) || '',
    items: items.map((it) => ({ name: it.product_name, qty: it.qty })),
    total: o.total,
    paidAt,
  });

  const sb = stepsBlock('paid');
  const msg = `${divider('sparkle')}\n\n   ${E.party}${E.confetti} <b>PEMBAYARAN BERHASIL!</b> ${E.confetti}${E.party}\n\n${divider('single')}\n\nTerima kasih atas kepercayaan Anda\nberbelanja di <b>${esc(SHOP())}</b> ${E.gem}\n\n${box([`${E.ticket} No. Order ─ <code>${orderId}</code>`])}\n\n${sb.bar}\n${sb.lines}\n\n${divider('dot')}\n<b>PRODUK ANDA</b>\n${divider('dot')}\n${delivered}\n\n<i>Mohon simpan data di atas dengan aman.</i>\n\n${E.star} Berikan penilaian Anda:\n${divider('sparkle')}`;
  const kb = Markup.inlineKeyboard([
    [Markup.button.callback('⭐', `rate:${orderId}:1`), Markup.button.callback('⭐⭐', `rate:${orderId}:2`), Markup.button.callback('⭐⭐⭐', `rate:${orderId}:3`), Markup.button.callback('⭐⭐⭐⭐', `rate:${orderId}:4`), Markup.button.callback('⭐⭐⭐⭐⭐', `rate:${orderId}:5`)],
    [Markup.button.url('👥 Gabung Grup Diskusi La Cukai', GROUP_URL())],
    [Markup.button.callback('🛍️ Belanja Lagi', 'cats'), Markup.button.callback('‹ Menu Utama', 'menu')],
  ]);
  await bot.telegram.sendMessage(o.user_id, msg, { parse_mode: 'HTML', ...kb }).catch(() => {});
  for (const aid of ADMIN_IDS) {
    bot.telegram.sendMessage(aid, `${E.money} <b>Order LUNAS</b>\n\n${box([
      `${E.ticket} <code>${orderId}</code>`,
      `${E.card} ${rp(o.total)}`,
    ])}`, { parse_mode: 'HTML' }).catch(() => {});
  }
  // low stock alert
  const th = Number(store.getSetting('low_stock_threshold', '3')) || 3;
  for (const it of items) {
    const p = store.getProduct(it.product_id);
    if (p && p.type === 'digital' && p.stock_n <= th) {
      for (const aid of ADMIN_IDS) bot.telegram.sendMessage(aid, `⚠️ <b>Stok menipis:</b> ${esc(p.name)} (sisa ${p.stock_n})`).catch(() => {});
    }
  }
  return true;
}

