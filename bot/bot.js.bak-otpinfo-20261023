async function createTopup(ctx, uid, amount) {
  amount = Math.round(Number(amount));
  if (!amount || amount < 5000) return ctx.reply(`${E.cross} Nominal isi saldo minimal ${rp(5000)}.`, { parse_mode: 'HTML', ...backMenu });
  if (amount > 2000000) return ctx.reply(`${E.cross} Nominal isi saldo maksimal ${rp(2000000)}.`, { parse_mode: 'HTML', ...backMenu });
  const topupId = makeTopupId();
  const publicUrl = (process.env.PUBLIC_URL || '').replace(/\/+$/, '');
  let qd;
  try {
    qd = await qris.create({ orderId: topupId, amount, keterangan: `Isi Saldo ${topupId}`.slice(0, 60), callbackUrl: publicUrl ? `${publicUrl}/webhook/qris` : '' });
  } catch (e) {
    console.error('[QRIS topup]', e.message);
    return ctx.reply('❌ Gagal membuat pembayaran isi saldo. Coba lagi sebentar.', { parse_mode: 'HTML', ...backMenu });
  }
  const expiredAt = qd.expired_at || new Date(Date.now() + EXP_MIN * 60000).toISOString();
  store.walletCreateTopup({ topup_id: topupId, user_id: uid, amount, qris_image: '', qris_url: qd.qris_url || '', expired_at: expiredAt, signature: qd.signature || '' });
  const expTime = new Date(expiredAt).toLocaleString('id-ID', { timeZone: 'Asia/Jakarta', hour: '2-digit', minute: '2-digit', day: 'numeric', month: 'short' });
  const lines = [
    `${E.money} <b>ISI SALDO</b>`,
    '',
    box([
      `${E.ticket} Nomor ─ <code>${topupId}</code>`,
      `${E.money} Nominal ─ <b>${rp(qd.total_amount ? Math.round(Number(qd.amount)) : amount)}</b>`,
      `${E.clock} Berlaku hingga ─ ${expTime} WIB`,
    ]),
    '',
    `${E.info} Setelah saldo masuk, saldo bisa langsung dipakai bayar belanja.`,
    '',
    divider('sparkle'),
  ];
  const kb = Markup.inlineKeyboard([
    [Markup.button.callback('✅ Saya Sudah Bayar', `tppaid:${topupId}`)],
    [Markup.button.callback('❌ Batalkan', `tpcancel:${topupId}`)],
  ]);
  let qrBuf = null;
  try { qrBuf = await qris.qrBuffer(qd.qris_image); } catch (e) {}
  let sent = null;
  try {
    if (qrBuf) sent = await ctx.replyWithPhoto({ source: qrBuf }, { caption: lines.join('\n'), parse_mode: 'HTML', ...kb });
    else if (qd.qris_url) sent = await ctx.replyWithPhoto(qd.qris_url, { caption: lines.join('\n'), parse_mode: 'HTML', ...kb });
    else sent = await ctx.reply(lines.join('\n'), { parse_mode: 'HTML', ...kb });
  } catch (e) { sent = await ctx.reply(lines.join('\n'), { parse_mode: 'HTML', ...kb }); }
  if (sent) store.setTopupQrisMsg(topupId, ctx.chat && ctx.chat.id, sent.message_id);
}

