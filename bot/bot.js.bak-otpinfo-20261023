// ---- Senna VCC helpers ----
async function attachSennaStock(list) {
  if (!list.some(p => p.type === 'vcc') || !senna.enabled()) return list;
  let cat;
  try { cat = await senna.catalog(); } catch (e) { return list; }
  for (const p of list) {
    if (p.type === 'vcc') {
      const sp = cat.find(s => s.id === p.senna_product_id);
      p.senna_stok = sp ? sp.stock : null;
      p.senna_price = sp ? sp.price : null;
    }
  }
  return list;
}

