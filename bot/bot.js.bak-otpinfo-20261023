async function showProducts(ctx, catId, page = 1) {
  let prods = store.productsByCat(catId);
  await attachSennaStock(prods);
  const cat = store.categories().find(c => c.id === catId);
  const title = cat ? cat.name : 'Katalog';
  if (!prods.length) return ctx.editMessageText(`📭 Belum ada produk di <b>${esc(title)}</b>.`, { parse_mode: 'HTML', ...backCats });
  // banner info khusus kategori VCC (tanpa pemblokiran — kartu diterbitkan otomatis saat supplier siap)
  const hasVcc = prods.some(p => p.type === 'vcc');
  let vccNote = '';
  if (hasVcc) {
    if (!senna.enabled()) {
      vccNote = `⚠️ <i>Layanan kartu sementara tidak aktif. Pembelian tetap bisa dibuat — kartu diterbitkan otomatis begitu layanan normal kembali.</i>`;
    } else {
      const dep = await senna.balance().catch(() => null);
      if (dep == null) vccNote = `⚠️ <i>Server kartu sedang gangguan. Pembelian tetap bisa dibuat — kartu diterbitkan otomatis begitu server normal.</i>`;
      else if (dep < 1000) vccNote = `ℹ️ <b>Cara kerja kartu:</b> dibayar → kartu terbit otomatis ke chat.\n⏳ <i>Stok kartu sedang kosong — kartu terbit otomatis begitu stok tersedia kembali (maks. 24 jam, melebihinya direfund).</i>`;
      else vccNote = `ℹ️ <i>Kartu dikirim otomatis ke chat (nomor, berlaku, CVV) tepat setelah pembayaran.</i>`;
    }
  }
  const pages = Math.max(1, Math.ceil(prods.length / LIST_PAGE));
  page = Math.min(Math.max(1, Number(page) || 1), pages);
  const slice = prods.slice((page - 1) * LIST_PAGE, page * LIST_PAGE);
  const rows = slice.map(p => {
    const stok = p.type === 'vcc'
      ? (p.senna_stok == null ? ' · ⏳ menunggu stok' : (p.senna_stok > 0 ? ` · 📦${p.senna_stok}` : ' · ⏳ menunggu stok'))
      : (p.type === 'digital' ? (p.stock_n > 0 ? ` · 📦${p.stock_n}` : ' · ❌habis') : '');
    const flash = flashPriceOf(p.id);
    return [Markup.button.callback(`${flash ? '⚡ ' : ''}${p.name} — ${rp(flash || p.price)}${stok}`, `prod:${p.id}:${page}`)];
  });
  rows.push(...pageNav(`cat:${catId}`, page, pages));
  rows.push([Markup.button.callback('‹ Kembali', 'cats')]);
  const pageNote = pages > 1 ? `\n${E.package} Halaman <b>${page}</b> dari <b>${pages}</b>` : '';
  const text = `${divider('sparkle')}\n\n${E.bag} <b>${esc(title.toUpperCase())}</b>\n${DIV}\n\nSentuh produk untuk melihat detail:${pageNote}\n\n${vccNote}\n\n${divider('sparkle')}`;
  try { await ctx.editMessageText(text, { parse_mode: 'HTML', ...Markup.inlineKeyboard(rows) }); }
  catch (e) { return ctx.reply(text, { parse_mode: 'HTML', ...Markup.inlineKeyboard(rows) }); }
}

