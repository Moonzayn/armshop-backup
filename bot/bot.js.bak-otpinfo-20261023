    store.setSetting('vcc_restock_users', '0');
    return ctx.reply('❌ Info restock VCC → <b>broadcast ke user bot DIMATIKAN</b>. Cek status: /vccinfo', { parse_mode: 'HTML' });
  });

  // ─── admin: broadcast produk baru/restock ke user bot ───
  bot.command('bcprod', async (ctx) => {
    if (!isAdmin(ctx)) return ctx.reply('⛔ Khusus admin.');
    const on = store.getSetting('product_notify_users', '1') !== '1';
    store.setSetting('product_notify_users', on ? '1' : '0');
    return ctx.reply(`📢 Broadcast <b>PRODUK BARU</b> ke user bot: <b>${on ? 'AKTIF' : 'MATI'}</b>`);
  });
  bot.command('bcrestock', async (ctx) => {
    if (!isAdmin(ctx)) return ctx.reply('⛔ Khusus admin.');
    const on = store.getSetting('restock_notify_users', '0') !== '1';
    store.setSetting('restock_notify_users', on ? '1' : '0');
    return ctx.reply(`📢 Broadcast <b>STOK BARU MASUK</b> ke user bot: <b>${on ? 'AKTIF' : 'MATI'}</b>`);
  });

  // ─── admin: flash sale config ───
  bot.command('flash', (ctx) => {
    if (!isAdmin(ctx)) return ctx.reply('⛔ Khusus admin.');
    const args = ctx.message.text.trim().split(/\s+/).slice(1);
    const cfg = readFlashCfg() || { active: false, ends_at: '', items: {} };
    cfg.items = cfg.items || {};
    const usage = `${E.bolt} <b>Konfigurasi Flash Sale</b>\n\n` +
      `<code>/flash</code> — lihat status\n` +
      `<code>/flash add &lt;product_id&gt; &lt;harga&gt; &lt;menit&gt;</code> — tambah/ubah item\n` +
      `<code>/flash remove &lt;product_id&gt;</code> — hapus item\n` +
      `<code>/flash end</code> — akhiri sekarang`;
    if (!args[0] || args[0] === 'status') {
      const active = getFlash();
      const items = Object.entries(cfg.items).map(([pid, pr]) => {
        const p = store.getProduct(pid);
        return `├ ${p ? esc(p.name) : pid} ─ ${rp(pr)}${p ? ` (normal ${rp(p.price)})` : ''}`;
      }).join('\n') || '├ (kosong)';
      return ctx.reply(`${E.bolt} <b>FLASH SALE</b>\n\nStatus: <b>${active ? '🟢 AKTIF' : '🔴 Nonaktif'}</b>${cfg.name ? `\nPromo: <b>${esc(cfg.name)}</b>` : ''}${cfg.starts_at ? `\nMulai: ${new Date(cfg.starts_at).toLocaleString('id-ID', { timeZone: 'Asia/Jakarta' })}` : ''}\nBerakhir: ${cfg.ends_at ? new Date(cfg.ends_at).toLocaleString('id-ID', { timeZone: 'Asia/Jakarta' }) : '-'}\n\n${items}\n\n${usage}`, { parse_mode: 'HTML' });
    }
    if (args[0] === 'add') {
      const [, pid, price, minutes] = args;
      if (!pid || !price || !minutes || !Number(price) || !Number(minutes)) return ctx.reply(usage, { parse_mode: 'HTML' });
      const p = store.getProduct(pid);
      if (!p) return ctx.reply('❌ Produk tidak ditemukan. Cek product_id yang valid.');
      cfg.items[pid] = Number(price);
      cfg.ends_at = new Date(Date.now() + Number(minutes) * 60000).toISOString();
      cfg.starts_at = '';
      cfg.active = true;
      writeFlash(cfg);
      return ctx.reply(`✅ <b>${esc(p.name)}</b> masuk flash sale:\n${rp(p.price)} → <b>${rp(Number(price))}</b>\nBerlaku ${minutes} menit.`, { parse_mode: 'HTML' });
    }
    if (args[0] === 'remove') {
      if (!args[1]) return ctx.reply(usage, { parse_mode: 'HTML' });
      delete cfg.items[args[1]];
      if (!Object.keys(cfg.items).length) cfg.active = false;
      writeFlash(cfg);
      return ctx.reply('✅ Item dihapus dari flash sale.');
    }
    if (args[0] === 'end') {
      cfg.active = false;
      writeFlash(cfg);
      return ctx.reply('✅ Flash sale diakhiri.');
    }
    return ctx.reply(usage, { parse_mode: 'HTML' });
  });

  // callbacks
  bot.action('menu', (ctx) => { ctx.answerCbQuery().catch(() => {}); return showMenu(ctx); });
  bot.action('noop', (ctx) => ctx.answerCbQuery().catch(() => {}));
  bot.action('cats', (ctx) => { ctx.answerCbQuery().catch(() => {}); return showCats(ctx); });
  bot.action('search', (ctx) => {
    ctx.answerCbQuery().catch(() => {});
    inputState.set(ctx.from.id, { mode: 'search' });
    return ctx.reply(`${E.search} <b>PENCARIAN PRODUK</b>\n\nKetik kata kunci produk, contoh:\n• <code>spotify</code>\n• <code>canva</code>\n• <code>vpn</code>\n• <code>gmail</code>`, { parse_mode: 'HTML', ...Markup.inlineKeyboard([[Markup.button.callback('Batal', 'menu')]]) });
  });
  bot.action(/^srch:(\d+):(\d+)$/, (ctx) => {
    ctx.answerCbQuery().catch(() => {});
    return renderSearch(ctx, ctx.match[1], Number(ctx.match[2]) || 1, true);
  });
  bot.action(/^(cat):(.+)/, (ctx) => {
    ctx.answerCbQuery().catch(() => {});
    const [catId, pg] = ctx.match[2].split(':');
    return showProducts(ctx, catId, Number(pg) || 1);
  });
  bot.action(/^(prod):(.+)/, (ctx) => {
    ctx.answerCbQuery().catch(() => {});
    const [pid, pg] = ctx.match[2].split(':');
    return showProduct(ctx, pid, Number(pg) || 1);
  });
  bot.action(/^(qty):(.+):(-?1)/, async (ctx) => {
    ctx.answerCbQuery().catch(() => {});
    const uid = ctx.from.id; const v = viewQty.get(uid);
    if (!v || v.prodId !== ctx.match[2]) return;
    const p = store.getProduct(v.prodId);
    const nq = Math.min(Math.max(v.qty + Number(ctx.match[3]), 1), 99);
    viewQty.set(uid, { prodId: v.prodId, qty: nq, page: v.page || 1 });
    await renderProduct(ctx, p, nq, v.page || 1);
  });
  bot.action(/^(addcart):(.+)/, async (ctx) => {
    const uid = ctx.from.id; const v = viewQty.get(uid);
    const pid = ctx.match[2];
    const qty = (v && v.prodId === pid) ? v.qty : 1;
    const cart = getCart(uid);
    cart.set(pid, (cart.get(pid) || 0) + qty);
    await ctx.answerCbQuery(`✅ ${qty}× ditambahkan ke keranjang`, false);
  });
  bot.action(/^(flashbuy):(.+)/, async (ctx) => {
    const pid = ctx.match[2];
    const fp = flashPriceOf(pid);
    if (!fp) return ctx.answerCbQuery('⚡ Flash sale sudah berakhir.', true);
    const uid = ctx.from.id; const v = viewQty.get(uid);
    const qty = (v && v.prodId === pid) ? v.qty : 1;
    await ctx.answerCbQuery().catch(() => {});
    const pend = { singleProd: pid, singleQty: qty, priceOverride: fp };
    checkoutPending.set(uid, pend);
    return showCheckoutConfirm(ctx, pend);
  });
  bot.action(/^(buy):(.+)/, async (ctx) => {
    await ctx.answerCbQuery().catch(() => {});
    const uid = ctx.from.id; const v = viewQty.get(uid);
