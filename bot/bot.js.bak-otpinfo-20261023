const DIV = '━'.repeat(22);

function divider(style = 'sparkle') {
  const dividers = {
    sparkle: '✨' + '━'.repeat(20) + '✨',
    double: '═'.repeat(25),
    single: '─'.repeat(25),
    dot: '• • • • • • • • • • • • • • •',
    wave: '〰️'.repeat(14),
    star: '✦ '.repeat(13),
  };
  return dividers[style] || dividers.sparkle;
}

function box(lines) {
  return `┌${'─'.repeat(28)}\n` + lines.map(l => `│ ${l}`).join('\n') + `\n└${'─'.repeat(28)}`;
}

function progressBar(current, total, length = 10) {
  const filled = Math.max(0, Math.min(length, Math.round((current / total) * length)));
  return '█'.repeat(filled) + '░'.repeat(length - filled);
}

function getGreeting() {
  let h;
  try {
    h = Number(new Intl.DateTimeFormat('en-GB', { timeZone: 'Asia/Jakarta', hour: '2-digit', hourCycle: 'h23' }).format(new Date()));
  } catch (e) { h = (new Date().getUTCHours() + 7) % 24; }
  if (h >= 5 && h < 12) return '🌅 Selamat Pagi';
  if (h >= 12 && h < 15) return '☀️ Selamat Siang';
  if (h >= 15 && h < 18) return '🌤️ Selamat Sore';
  return '🌙 Selamat Malam';
}

function fmtCountdown(ms) {
  if (ms <= 0) return '00:00:00';
  const s = Math.floor(ms / 1000);
  const pad = (n) => String(n).padStart(2, '0');
  if (s >= 86400) return `${Math.floor(s / 86400)}h ${pad(Math.floor(s % 86400 / 3600))}m`;
  return `${pad(Math.floor(s / 3600))}:${pad(Math.floor(s % 3600 / 60))}:${pad(s % 60)}`;
}

function discountPct(oldP, newP) {
  if (!oldP || oldP <= newP) return 0;
  return Math.round((1 - newP / oldP) * 100);
}

// ─── data helpers ───
function trustStats() {
  const users = store.db.prepare('SELECT COUNT(*) c FROM users').get().c;
  const paid = store.db.prepare("SELECT COUNT(*) c FROM orders WHERE status='paid'").get().c;
  let voucher = null;
  try { voucher = store.db.prepare("SELECT code FROM vouchers WHERE is_active=1 AND (quota=0 OR used<quota) ORDER BY id DESC LIMIT 1").get(); } catch (e) {}
  return { users, paid, voucher };
}

function soldCount(pid) {
  return store.db.prepare(`SELECT COALESCE(SUM(oi.qty),0) v FROM order_items oi
    JOIN orders o ON o.order_id=oi.order_id
    WHERE o.status='paid' AND oi.product_id=?`).get(pid).v;
}

function memberTier(paidN) {
  const tiers = [
    { min: 0, icon: '🥉', name: 'Bronze', benefit: '-' },
    { min: 3, icon: '🥈', name: 'Silver', benefit: 'Diskon ekstra 5%' },
    { min: 5, icon: '🥇', name: 'Gold', benefit: 'Diskon ekstra 10%' },
    { min: 10, icon: '👑', name: 'Diamond', benefit: 'Diskon ekstra 15% + prioritas' },
  ];
  let idx = 0;
  for (let i = 0; i < tiers.length; i++) if (paidN >= tiers[i].min) idx = i;
  const cur = tiers[idx];
  const next = tiers[idx + 1] || null;
  const progress = next ? Math.min(100, Math.round(((paidN - cur.min) / (next.min - cur.min)) * 100)) : 100;
  return { cur, next, progress };
}

function stepsBlock(status) {
  const states = {
    pending: ['done', 'active', 'todo', 'todo'],
    paid: ['done', 'done', 'done', 'done'],
    expired: ['done', 'fail', 'todo', 'todo'],
    cancelled: ['done', 'fail', 'todo', 'todo'],
  };
  let labels = ['Order dibuat', 'Menunggu pembayaran (QRIS)', 'Pembayaran diverifikasi', 'Produk dikirim'];
  if (status === 'expired') labels = ['Order dibuat', 'Pembayaran kadaluarsa', 'Pembayaran diverifikasi', 'Produk dikirim'];
  if (status === 'cancelled') labels = ['Order dibuat', 'Pesanan dibatalkan', 'Pembayaran diverifikasi', 'Produk dikirim'];
  const marks = { done: '✅', active: '⏳', todo: '⬜', fail: '❌' };
  const nums = ['1️⃣', '2️⃣', '3️⃣', '4️⃣'];
  const st = states[status] || states.pending;
  const done = st.filter(s => s === 'done').length;
  const lines = st.map((s, i) => {
    const prefix = i === st.length - 1 ? '└' : '├';
    const label = s === 'active' ? `<b>${labels[i]}</b>` : labels[i];
    return `${prefix} ${nums[i]} ${marks[s]} ${label}`;
  }).join('\n');
  return { bar: progressBar(done, st.length, 15), lines, done, total: st.length };
}

// ─── flash sale config (settings JSON) ───
function readFlashCfg() {
  try {
    const c = JSON.parse(store.getSetting('flash_sale', '') || '');
    return c && typeof c === 'object' ? c : null;
  } catch (e) { return null; }
}
function getFlash() {
  const c = readFlashCfg();
  if (!c || !c.active || !c.ends_at || !c.items) return null;
  if (c.starts_at && new Date(c.starts_at).getTime() > Date.now()) return null;
  if (new Date(c.ends_at).getTime() <= Date.now()) return null;
  if (!Object.keys(c.items).length) return null;
  return c;
}
function flashPriceOf(pid) {
  const f = getFlash();
  return f && f.items[pid] ? Number(f.items[pid]) : 0;
}
function writeFlash(cfg) { store.setSetting('flash_sale', JSON.stringify(cfg)); }

