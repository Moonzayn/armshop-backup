function importXLSX(){
 const cols=[['name','Nama produk (wajib)'],['price','Harga dalam Rupiah'],['type','digital / manual'],['category','Nama kategori (otomatis dibuat)'],['description','Deskripsi produk'],['photo_url','Link foto produk'],['stock','Kode stok, pisahkan dengan ;']];
 openModal('<h3>Import Produk via Excel</h3>'+
 '<p style="color:var(--muted);font-size:12.5px;margin-bottom:12px">Upload file .xlsx dengan baris pertama sebagai nama kolom berikut:</p>'+
 '<table style="margin-bottom:14px"><tr><th>Kolom</th><th>Keterangan</th></tr>'+
 cols.map(c=>'<tr><td><code>'+c[0]+'</code></td><td style="color:var(--muted)">'+c[1]+'</td></tr>').join('')+'</table>'+
 '<label class="fl">Pilih file Excel</label><input type="file" id="x-file" accept=".xlsx,.xls">'+
 '<div id="x-msg" style="font-size:12.5px;margin:4px 0 8px;min-height:18px"></div>'+
 '<div class="mfoot"><button class="btn ghost" onclick="closeModal()">Batal</button><button class="btn" onclick="doImportXLSX()">Mulai Import</button></div>');
}
async function doImportXLSX(){const f=document.getElementById('x-file');if(!f.files.length)return;
 document.getElementById('x-msg').textContent='Mengimpor…';
 const fd=new FormData();fd.append('file',f.files[0]);
 const r=await fetch('/api/import-products',{method:'POST',body:fd});const j=await r.json();
 if(j.ok){document.getElementById('x-msg').textContent=j.added+' produk ditambahkan'+(j.skipped?', '+j.skipped+' baris dilewati':'')+'.';setTimeout(()=>{closeModal();loadProducts();},1200);}
 else document.getElementById('x-msg').textContent='Gagal: '+j.error;}
