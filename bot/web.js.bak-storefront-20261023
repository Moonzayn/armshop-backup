const senna = require('./senna');

app.get('/api/products', async (req, res) => {
  const rows = store.allProducts();
  try {
    if (rows.some(p => p.type === 'vcc') && senna.enabled()) {
      const cat = await senna.catalog();
      for (const p of rows) {
        if (p.type !== 'vcc') continue;
        const sp = cat.find(s => s.id === p.senna_product_id);
        p.stock_n = sp ? sp.stock : p.stock_n;
        p.senna_variant = sp ? sp.variant : '';
        p.senna_harga = sp ? sp.price : null;
      }
    }
  } catch (e) { /* biarkan stock_n lokal */ }
  res.json(rows);
});
