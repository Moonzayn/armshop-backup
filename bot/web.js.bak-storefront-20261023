// ---- QRIS webhook (public, signature-validated) ----
app.post('/webhook/qris', async (req, res) => {
  try {
    const { order_id, status, signature } = req.body || {};
    const st = String(status || '').toUpperCase();
    // ---- topup saldo (TP-xxx) ----
    if (order_id && String(order_id).startsWith('TP-')) {
      if (st === 'PAID' || st === 'SUCCESS' || st === 'SETTLED') {
        const t = store.walletGetTopup(order_id);
        // signature wajib cocok (wallet = uang) — kalau topup punya signature, webhook harus menyertakan yang cocok
        if (!t || (t.signature && (!signature || t.signature !== signature))) return res.status(200).send('OK');
        if (store.walletCreditTopup(order_id) && global._bot) {
          global._bot.telegram.sendMessage(t.user_id,
            `💰 <b>Isi saldo ${rp(t.amount)} BERHASIL!</b>\n\n<i>Saldo siap dipakai belanja.</i>`,
            { parse_mode: 'HTML' }).catch(() => {});
        }
      } else if ((st === 'EXPIRED' || st === 'CANCELLED')) {
        store.walletSetTopupStatus(order_id, 'expired');
      }
      return res.status(200).send('OK');
    }
    // ---- order produk ----
    const o = order_id ? store.getOrder(order_id) : null;
    // validasi signature cegah fake webhook
    if (!o || (o.signature && signature && o.signature !== signature)) return res.status(200).send('OK');
    if ((st === 'PAID' || st === 'SUCCESS') && o.status !== 'paid') {
      const { fulfillOrder } = require('./bot');
      if (global._bot) await fulfillOrder(global._bot, order_id, req.body.payment_date || new Date().toISOString());
    } else if (st === 'EXPIRED' && o.status === 'pending') {
      store.setOrderStatus(order_id, 'expired');
    }
  } catch (e) { console.error('[webhook]', e.message); }
  res.status(200).send('OK'); // selalu 200 agar tidak di-retry
});

const auth = (req, res, next) => {
  const t = (req.headers.cookie || '').split(';').map(s => s.trim()).find(s => s.startsWith('sess='));
  if (t && sessions.has(t.slice(5))) return next();
  if (req.path.startsWith('/api/')) return res.status(401).json({ error: 'unauthorized' });
  return res.redirect('/login');
};

