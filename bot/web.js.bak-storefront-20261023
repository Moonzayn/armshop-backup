app.post('/api/products/bulk', (req, res) => {
  const ids = Array.isArray(req.body.ids) ? req.body.ids : [];
  const action = String(req.body.action || '');
  if (!ids.length || !['activate', 'deactivate', 'delete'].includes(action)) return res.status(400).json({ error: 'ids/action tidak valid' });
  store.db.transaction(() => {
    if (action === 'activate') ids.forEach(i => store.db.prepare('UPDATE products SET is_active=1 WHERE id=?').run(i));
    else if (action === 'deactivate') ids.forEach(i => store.db.prepare('UPDATE products SET is_active=0 WHERE id=?').run(i));
    else ids.forEach(i => {
      store.db.prepare('DELETE FROM stock WHERE product_id=?').run(i);
      store.db.prepare('DELETE FROM products WHERE id=?').run(i);
    });
  })();
  res.json({ ok: true, affected: ids.length });
});
