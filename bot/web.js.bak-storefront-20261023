function bulkAll(on){document.querySelectorAll('.pchk').forEach(b=>{if(on)prodSel.add(b.dataset.id);else prodSel.delete(b.dataset.id);});renderProducts();}
async function bulkAct(action){
 if(!prodSel.size)return;
 if(action==='delete'&&!confirm('Hapus PERMANEN '+prodSel.size+' produk?\\n\\nStok yang belum terpakai ikut terhapus. Tindakan ini tidak bisa dibatalkan.'))return;
 const r=await api('POST','/api/products/bulk',{ids:Array.from(prodSel),action});
 if(r&&r.ok)showToast(r.affected+' produk diperbarui');
 prodSel.clear();loadProducts();
}
async function activateProd(id){await api('POST','/api/products/'+id+'/activate');loadProducts();}
async function deleteProd(id){
 const p=prodCache.find(x=>x.id===id);
 if(!confirm('Hapus permanen "'+(p?p.name:id)+'"?\\n\\nStok yang belum terpakai ikut terhapus.'))return;
 await api('DELETE','/api/products/'+id+'?hard=1');loadProducts();
}

