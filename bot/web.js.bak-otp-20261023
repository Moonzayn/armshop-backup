 const snStat=(sn.enabled?'<div class="stat" style="'+(sn.low?'outline:2px solid #ef4444;outline-offset:-2px':'')+'"><div class="l">Saldo VCC (Senna)</div><div class="v">'+(sn.deposit==null?'—':rp(sn.deposit))+'</div><div class="d">'+(sn.error?esc(sn.error):(sn.low?'⚠️ rendah — top up segera':'siap terbit kartu'))+'</div></div>'+'<div class="stat"><div class="l">Ambang VCC</div><div class="v">'+rp(sn.low_threshold)+'</div><div class="d">peringatan saat di bawah ini</div></div>':'');
 document.getElementById('p-dash').innerHTML=notice+
 '<div class="grid">'+
 '<div class="stat"><div class="l">Omzet Hari Ini</div><div class="v">'+rp(s.today_revenue)+'</div><div class="d">'+s.today_orders+' order hari ini</div></div>'+
 '<div class="stat"><div class="l">Order Pending</div><div class="v">'+s.pending+'</div><div class="d">menunggu pembayaran</div></div>'+
