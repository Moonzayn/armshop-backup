const bcJobs = new Map();
app.post('/api/broadcast', async (req, res) => {
  const productIds = Array.isArray(req.body.productIds) ? req.body.productIds.slice(0, 10) : [];
  const prods = productIds.map(id => store.getProduct(String(id))).filter(p => p && p.is_active);
  let text = String(req.body.text || '');
  let reply_markup;
  if (prods.length) {
    const lines = prods.map(p => {
      const pr = sfPromoPrice(p.id);
      return pr
        ? `🛍 <b>${sfEsc(p.name)}</b>\n<s>${sfRp(p.price)}</s> <b>${sfRp(pr)}</b> ⚡`
        : `🛍 <b>${sfEsc(p.name)}</b> — <b>${sfRp(p.price)}</b>`;
    });
    text = (text ? text + '\n\n' : '') + lines.join('\n\n');
    reply_markup = { inline_keyboard: prods.map(p => [{ text: ('🛒 ' + p.name).slice(0, 32), callback_data: 'prod:' + p.id }]) };
  }
  if (!text) return res.status(400).json({ error: 'Isi pesan atau pilih produk dulu' });
  const totalUsers = store.db.prepare('SELECT COUNT(*) AS n FROM users').get().n;
  if (req.body.dryRun) return res.json({ ok: true, dryRun: true, text, buttons: prods.map(p => p.id), total: totalUsers });
  const users = store.db.prepare('SELECT id FROM users').all();
  const jobId = 'bc' + Date.now().toString(36) + Math.floor(Math.random() * 1e4);
  const job = { id: jobId, total: users.length, sent: 0, failed: 0, done: false, started_at: new Date().toISOString(), finished_at: '' };
  bcJobs.set(jobId, job);
  if (bcJobs.size > 20) bcJobs.delete(bcJobs.keys().next().value);
  res.json({ ok: true, jobId, total: users.length });
  (async () => {
    for (const u of users) {
      try { await global._bot.telegram.sendMessage(u.id, text, { parse_mode: 'HTML', ...(reply_markup ? { reply_markup } : {}) }); job.sent++; }
      catch (e) { job.failed++; }
      await new Promise(r => setTimeout(r, 60));
    }
    job.done = true; job.finished_at = new Date().toISOString();
  })().catch(e => { job.done = true; job.error = e.message; });
});
app.get('/api/broadcast/progress/:id', (req, res) => {
