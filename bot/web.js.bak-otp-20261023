.side-foot button{display:flex;gap:12px;align-items:center;width:100%;background:none;border:0;color:var(--muted);padding:10px 12px;border-radius:9px;font-size:13.5px;cursor:pointer}
.side-foot button:hover{background:var(--surface2);color:var(--text)}
/* main */
main{flex:1;padding:30px 34px;max-width:1180px;min-width:0}
.topbar{display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:24px}
.topbar h2{font-size:21px;letter-spacing:-.3px;font-weight:650}
.topbar .sub{color:var(--muted);font-size:13px;margin-top:4px}
.topbar .date{color:var(--muted);font-size:12.5px;background:var(--surface);border:1px solid var(--border);padding:8px 14px;border-radius:9px}
/* cards & stats */
.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(210px,1fr));gap:14px;margin-bottom:20px}
.stat{background:var(--surface);border:1px solid var(--border);border-radius:13px;padding:18px 20px}
.stat .l{color:var(--muted);font-size:11.5px;font-weight:600;text-transform:uppercase;letter-spacing:.6px;margin-bottom:8px}
.stat .v{font-size:26px;font-weight:700;letter-spacing:-.5px}
.stat .d{font-size:12px;color:var(--muted);margin-top:6px}
.card{background:var(--surface);border:1px solid var(--border);border-radius:13px;padding:20px;margin-bottom:18px}
.card h3{font-size:15px;font-weight:650;margin-bottom:14px}
/* notice (low stock) */
.notice{display:flex;gap:14px;background:rgba(245,158,11,.06);border:1px solid rgba(245,158,11,.28);border-radius:13px;padding:16px 18px;margin-bottom:20px;align-items:flex-start}
.notice svg{color:var(--warn);flex-shrink:0;margin-top:2px}
.notice .nt{flex:1}.notice .nt b{font-size:13.5px;display:block;margin-bottom:2px}
.notice .nt span{font-size:12.5px;color:var(--muted)}
.notice ul{margin:8px 0 0 2px;list-style:none;padding:0}
.notice li{font-size:12.5px;padding:5px 0;border-top:1px solid rgba(245,158,11,.14);display:flex;justify-content:space-between}
.notice li b{color:var(--warn)}
.notice .nx{background:none;border:0;color:var(--muted);cursor:pointer;padding:4px;border-radius:6px}
.notice .nx:hover{color:var(--text);background:rgba(255,255,255,.06)}
/* table */
table{width:100%;border-collapse:collapse;font-size:13px}
th{text-align:left;color:var(--muted);font-weight:600;font-size:11.5px;text-transform:uppercase;letter-spacing:.5px;padding:10px 12px;border-bottom:1px solid var(--border)}
td{padding:12px;border-bottom:1px solid #1a212c;vertical-align:middle}
tr:last-child td{border-bottom:0}
tbody tr{transition:background .1s}tbody tr:hover{background:rgba(255,255,255,.015)}
.badge{display:inline-flex;align-items:center;padding:4px 11px;border-radius:99px;font-size:11.5px;font-weight:600}
.b-pending{background:rgba(245,158,11,.13);color:#fbbf24}
.b-paid{background:rgba(34,197,94,.13);color:#4ade80}
.b-expired,.b-cancelled{background:rgba(239,68,68,.11);color:#f87171}
code{background:#0b0e13;border:1px solid var(--border);padding:3px 8px;border-radius:6px;font-size:12px;font-family:ui-monospace,monospace}
/* buttons */
.btn{display:inline-flex;align-items:center;gap:7px;background:var(--accent);border:0;color:#fff;padding:9px 16px;border-radius:9px;font-size:13px;font-weight:600;cursor:pointer;transition:background .12s}
.btn:hover{background:var(--accent-h)}
.btn.ghost{background:var(--surface2);border:1px solid var(--border2);color:var(--text)}
.btn.ghost:hover{border-color:#3a4557;background:#1c2330}
.btn.danger{background:rgba(239,68,68,.1);color:#f87171;border:1px solid rgba(239,68,68,.25)}
.btn.danger:hover{background:rgba(239,68,68,.18)}
.btn.sm{padding:6px 12px;font-size:12px;border-radius:7px}
.btn svg{width:14px;height:14px}
/* forms */
.fgrid{display:grid;gap:0}
label.fl{font-size:12px;color:var(--muted);display:block;margin-bottom:6px;font-weight:600}
input,select,textarea{background:#0b0e13;border:1px solid var(--border2);border-radius:9px;color:#fff;padding:10px 12px;font-size:13.5px;width:100%;outline:none;margin-bottom:14px;transition:border-color .12s}
input:focus,select:focus,textarea:focus{border-color:var(--accent)}
textarea{resize:vertical;font-family:inherit}
.row2{display:grid;grid-template-columns:1fr 1fr;gap:12px}
/* tabs */
.tabs{display:flex;gap:6px;margin-bottom:16px;background:var(--surface);border:1px solid var(--border);padding:4px;border-radius:11px;width:fit-content}
.tabs button{background:none;border:0;color:var(--muted);padding:8px 16px;border-radius:8px;font-size:13px;font-weight:500;cursor:pointer;text-transform:capitalize}
.tabs button.on{background:var(--surface2);color:#fff;box-shadow:inset 0 0 0 1px var(--border2)}
/* products */
.prod-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(250px,1fr));gap:14px}
.prod{background:var(--surface);border:1px solid var(--border);border-radius:13px;overflow:hidden;transition:border-color .15s,transform .15s}
.prod:hover{border-color:#334052;transform:translateY(-2px)}
.prod .pimg{height:140px;background:var(--surface2);display:flex;align-items:center;justify-content:center;color:var(--muted)}
.prod img{width:100%;height:140px;object-fit:cover}
.prod .pb{padding:16px}
.prod .pn{font-weight:650;font-size:14px;margin-bottom:4px;letter-spacing:-.2px}
.prod .pm{font-size:12px;color:var(--muted);margin-bottom:8px}
.prod .pp{font-size:17px;font-weight:700;color:var(--accent);margin-bottom:10px;letter-spacing:-.3px}
.prod .pf{display:flex;gap:8px;align-items:center;justify-content:space-between}
.stockpill{font-size:11.5px;font-weight:600;padding:4px 10px;border-radius:99px;background:rgba(34,197,94,.12);color:#4ade80}
.selrow{background:rgba(59,130,246,.06)}
.toast{position:fixed;bottom:24px;right:24px;background:var(--surface,#1e2433);color:var(--text,#e6e9ef);border:1px solid var(--border);padding:10px 16px;border-radius:12px;font-size:13px;box-shadow:0 8px 30px rgba(0,0,0,.35);z-index:999;opacity:0;transition:opacity .2s;pointer-events:none}
.toast.on{opacity:1}
.stockpill.low{background:rgba(245,158,11,.13);color:#fbbf24}
.stockpill.out{background:rgba(239,68,68,.11);color:#f87171}
/* modal */
.modal{position:fixed;inset:0;background:rgba(4,6,10,.65);backdrop-filter:blur(3px);display:none;align-items:center;justify-content:center;z-index:50;padding:20px}
.modal.open{display:flex}
.mbox{background:var(--surface);border:1px solid var(--border2);border-radius:16px;padding:26px;width:500px;max-width:94vw;max-height:90vh;overflow:auto;box-shadow:0 24px 70px rgba(0,0,0,.5)}
.mbox h3{margin-bottom:18px;font-size:16px}
.mbox .mfoot{display:flex;gap:10px;justify-content:flex-end;margin-top:6px}
pre{white-space:pre-wrap;font-size:12px;background:#0b0e13;border:1px solid var(--border);padding:12px;border-radius:9px;max-height:200px;overflow:auto;font-family:ui-monospace,monospace}
.kv{display:grid;grid-template-columns:130px 1fr;gap:8px 12px;font-size:13px;margin:14px 0}
.kv dt{color:var(--muted)}.kv dd{margin:0}
.page{display:none}.page.on{display:block;animation:fade .18s ease}
@keyframes fade{from{opacity:0;transform:translateY(4px)}to{opacity:1}}
.toolbar{display:flex;gap:10px;margin-bottom:16px;flex-wrap:wrap}
.empty{color:var(--muted);text-align:center;padding:30px;font-size:13px}
@media(max-width:860px){aside{width:64px;padding:18px 10px}.brand .t,nav button span{display:none}.brand{justify-content:center;padding-bottom:16px}main{padding:20px}}
