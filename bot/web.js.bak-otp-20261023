  if(r&&r.ok){ box.style.display='block'; box.textContent=r.text; var note=$('bc-prev-note'); if(note) note.textContent='Pratinjau — akan dikirim ke '+r.total+' pelanggan dengan '+(r.buttons?r.buttons.length:0)+' tombol produk di bawah pesan.'; }
  else showToast((r&&r.error)||'Gagal membuat pratinjau');
};
window.bcSendX=function(){
  var t=($('b-text')||{}).value||''; if(!t&&!bcSelX.size){showToast('Isi pesan atau pilih produk dulu');return;}
  bcRunX(t, Array.from(bcSelX));
};
var bcPendingX=null, bcTimerX=null;
window.bcRunX=function(text, productIds){
  bcPendingX={text:text, productIds:productIds||[]};
  var prodLine=bcPendingX.productIds.length?'<p style="font-size:13px;margin-bottom:10px">Dengan lampiran <b>'+bcPendingX.productIds.length+' produk</b> pilihan (nama, harga & tombol beli di bawah pesan).</p>':'';
  openModal('<h3>Kirim Broadcast</h3>'+
  '<p style="font-size:13px;color:var(--muted);margin:-8px 0 12px">Pesan ini akan dikirim ke semua pelanggan yang pernah membuka bot.</p>'+prodLine+
  '<pre style="max-height:170px">'+esc(text)+'</pre>'+
  '<div class="mfoot"><button class="btn ghost" onclick="closeModal()">Batal</button><button class="btn" onclick="bcStartX()">Kirim Sekarang</button></div>');
};
window.bcStartX=async function(){
  if(!bcPendingX) return;
  var job=bcPendingX; bcPendingX=null;
  var r=await api('POST','/api/broadcast',{text:job.text, productIds:job.productIds});
  if(!r||!r.ok||!r.jobId){ showToast((r&&r.error)||'Gagal memulai broadcast'); return; }
  openModal('<h3>Mengirim Broadcast…</h3>'+
  '<div style="height:10px;background:var(--surface2);border:1px solid var(--border);border-radius:99px;overflow:hidden"><div id="bcj-bar" style="height:100%;width:0%;background:var(--accent);transition:width .35s"></div></div>'+
  '<div style="display:flex;justify-content:space-between;font-size:12.5px;color:var(--muted);margin-top:10px"><span id="bcj-count">Menyiapkan…</span><span id="bcj-pct" style="font-weight:700;color:var(--text)">0%</span></div>'+
  '<div id="bcj-note" style="font-size:12.5px;margin-top:10px;color:var(--muted)">Pengiriman berjalan di server — jendela ini boleh ditutup, broadcast tetap lanjut sampai selesai.</div>'+
  '<div class="mfoot"><button class="btn ghost" onclick="bcCloseX()">Tutup</button></div>');
  bcPollX(r.jobId);
};
window.bcCloseX=function(){ if(bcTimerX){clearInterval(bcTimerX); bcTimerX=null;} closeModal(); };
window.bcPollX=function(jobId){
  if(bcTimerX) clearInterval(bcTimerX);
  var tick=async function(){
    var p=await api('GET','/api/broadcast/progress/'+jobId);
    if(!p||!p.ok){ if(bcTimerX)clearInterval(bcTimerX); var n=$('bcj-note'); if(n)n.textContent='Gagal membaca progres pengiriman.'; return; }
    var total=p.total||0, sent=p.sent||0, failed=p.failed||0, doneN=sent+failed;
    var pct=total?Math.round(doneN/total*100):0;
    var bar=$('bcj-bar'), cnt=$('bcj-count'), pc=$('bcj-pct'), note=$('bcj-note');
    if(bar)bar.style.width=pct+'%';
    if(cnt)cnt.textContent=doneN+' / '+total+' diproses · '+sent+' terkirim'+(failed?' · '+failed+' gagal':'');
    if(pc)pc.textContent=pct+'%';
    if(p.done){ if(bcTimerX)clearInterval(bcTimerX); if(note){ note.style.color='var(--text)'; note.innerHTML='<b>Selesai.</b> Terkirim '+sent+' dari '+total+' pelanggan'+(failed?' · '+failed+' gagal (kemungkinan memblokir bot atau belum pernah start)':'')+'.'; } showToast('Broadcast selesai: '+sent+' terkirim'); }
  };
  tick();
  bcTimerX=setInterval(tick, 900);
};
