  try { store.db.prepare(`ALTER TABLE orders ADD COLUMN ${col}`).run(); } catch (e) { /* kolom sudah ada */ }
}
const WEB_ADMIN_IDS = (process.env.ADMIN_IDS || '').split(',').map(s => Number(s.trim())).filter(Boolean);
const sfRp = (n) => 'Rp' + Number(n || 0).toLocaleString('id-ID');
const sfEsc = (x) => String(x ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
const sfSellable = (p) => p && p.is_active && (p.type !== 'vcc' || (p.senna_product_id && senna.enabled())) && !STOREFRONT_BLOCKED_CATS.has(p.category_id);
const sfMakeOrderId = () => {
  const d = new Date();
  const ds = `${String(d.getDate()).padStart(2, '0')}${String(d.getMonth() + 1).padStart(2, '0')}${String(d.getFullYear()).slice(2)}`;
  return `LC-${ds}-${Math.floor(1000 + Math.random() * 9000)}`;
};
const sfVoucherDiscount = (code, amount) => {
  if (!code) return { discount: 0, voucherCode: '' };
  const v = store.getVoucher(String(code).trim());
  if (!v) return { error: 'Kode promo tidak ditemukan atau sudah tidak aktif.' };
  if (v.quota && v.used >= v.quota) return { error: 'Kuota kode promo ini sudah habis.' };
  if (amount < (v.min_amount || 0)) return { error: `Kode promo berlaku untuk belanja minimal ${sfRp(v.min_amount)}.` };
  const discount = v.kind === 'percent' ? Math.round(amount * v.value / 100) : Math.min(v.value, amount);
  return { discount, voucherCode: v.code };
};
const sfOrderHits = new Map();
const sfRateLimited = (ip) => {
  const now = Date.now();
  const arr = (sfOrderHits.get(ip) || []).filter(t => now - t < 10 * 60000);
  arr.push(now);
  sfOrderHits.set(ip, arr);
  return arr.length > 15;
};

app.post('/api/storefront/promo', (req, res) => {
  try {
    const { code, amount } = req.body || {};
    const amt = Math.round(Number(amount) || 0);
    if (!code || amt <= 0) return res.status(400).json({ error: 'Kode promo / nominal tidak valid.' });
    const r = sfVoucherDiscount(code, amt);
    if (r.error) return res.status(400).json({ error: r.error });
    res.json({ code: r.voucherCode, discount: r.discount });
  } catch (e) { res.status(500).json({ error: e.message }); }
});

app.post('/api/storefront/order', async (req, res) => {
  try {
    if (sfRateLimited(req.ip || 'x')) return res.status(429).json({ error: 'Terlalu banyak percobaan. Coba lagi beberapa menit lagi.' });
    const { items, customer, voucher } = req.body || {};
    if (!Array.isArray(items) || !items.length) return res.status(400).json({ error: 'Keranjang kosong.' });
    const name = String((customer || {}).name || '').trim().slice(0, 80);
    const email = String((customer || {}).email || '').trim().slice(0, 120);
    const whatsapp = String((customer || {}).whatsapp || '').trim().slice(0, 30);
    const notes = String((customer || {}).notes || '').trim().slice(0, 300);
    if (name.length < 2) return res.status(400).json({ error: 'Nama wajib diisi.' });
    if (!/^\S+@\S+\.\S+$/.test(email)) return res.status(400).json({ error: 'Email tidak valid.' });
    const lines = [];
    for (const it of items.slice(0, 20)) {
      const p = store.getProduct(String((it || {}).id || ''));
      if (!sfSellable(p)) return res.status(400).json({ error: 'Ada produk yang tidak tersedia untuk pembelian via web.' });
      const qty = Math.max(1, Math.min(99, Math.round(Number((it || {}).qty) || 1)));
      if (p.type === 'digital' && (p.stock_n || 0) < qty) return res.status(400).json({ error: `Stok ${p.name} tidak mencukupi.` });
      lines.push({ p, qty, unit: sfPromoPrice(p.id) || p.price });
    }
    const amount = lines.reduce((a, l) => a + l.unit * l.qty, 0);
    const vd = sfVoucherDiscount(voucher, amount);
    if (vd.error) return res.status(400).json({ error: vd.error });
    const total = Math.max(amount - vd.discount, 1000);
    let orderId = sfMakeOrderId();
    for (let i = 0; i < 5 && store.getOrder(orderId); i++) orderId = sfMakeOrderId();
    const keterangan = `Order ${orderId} - La Cukai Shop`.slice(0, 60);
    const publicUrl = (process.env.PUBLIC_URL || '').replace(/\/+$/, '');
    let qd;
    try {
      qd = await qris.create({ orderId, amount: total, keterangan, callbackUrl: publicUrl ? `${publicUrl}/webhook/qris` : '' });
    } catch (e) {
      console.error('[web-order QRIS]', e.message);
      return res.status(502).json({ error: 'Gagal membuat tagihan QRIS. Coba lagi sebentar.' });
    }
    const expiredAt = qd.expired_at || new Date(Date.now() + 60 * 60000).toISOString();
    const prodName = lines.length === 1 ? `${lines[0].p.name} ×${lines[0].qty}` : `${lines.length} produk`;
    store.db.prepare(`INSERT INTO orders(order_id,user_id,product_id,product_name,qty,amount,discount,total,voucher_code,qris_image,qris_url,expired_at,signature,source,cust_name,cust_email,cust_contact,cust_notes)
      VALUES(?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?)`).run(orderId, 0, lines[0].p.id, prodName, lines.reduce((a, l) => a + l.qty, 0),
      amount, vd.discount, Number(qd.total_amount || total), vd.voucherCode, qd.qris_image || '', qd.qris_url || '', expiredAt, qd.signature || '', 'web', name, email, whatsapp, notes);
    const insItem = store.db.prepare('INSERT INTO order_items(order_id,product_id,product_name,qty,price) VALUES(?,?,?,?,?)');
    lines.forEach(l => insItem.run(orderId, l.p.id, l.p.name, l.qty, l.unit));
    if (vd.voucherCode) store.useVoucher(vd.voucherCode);
    if (global._bot) {
      for (const aid of WEB_ADMIN_IDS) {
        global._bot.telegram.sendMessage(aid, `🛒 <b>Order Baru (Web)</b>\n\n🧾 <code>${orderId}</code>\n👤 ${sfEsc(name)} (${sfEsc(whatsapp || email)})\n📦 ${sfEsc(prodName)}\n💰 ${sfRp(qd.total_amount || total)}`, { parse_mode: 'HTML' }).catch(() => {});
      }
    }
    res.json({ orderId, amount, discount: vd.discount, total: Number(qd.total_amount || total), qrisImage: qd.qris_image || '', qrisUrl: qd.qris_url || '', expiredAt });
  } catch (e) { res.status(500).json({ error: e.message }); }
});

