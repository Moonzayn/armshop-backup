let anaDays=30;
function svgBars(data,maxV,color){const W=560,H=180,P=30,bw=Math.max(2,(W-P*2)/data.length-4);
let s='<svg viewBox="0 0 '+W+' '+H+'" style="width:100%;height:auto">';
for(let g=0;g<=4;g++){const y=P+(H-P*2)*g/4;s+='<line x1="'+P+'" y1="'+y+'" x2="'+(W-10)+'" y2="'+y+'" stroke="#222a35" stroke-width="1"/>';}
data.forEach((d,i)=>{const h=maxV?(d.v/maxV)*(H-P*2):0;const x=P+i*((W-P*2)/data.length)+2;
s+='<rect x="'+x+'" y="'+(H-P-h)+'" width="'+bw+'" height="'+h+'" rx="3" fill="'+color+'"><title>'+d.l+': '+d.t+'</title></rect>';});
return s+'</svg>';}
