var bcSelX=new Set();
window.bcToggleX=function(id,on){ if(on) bcSelX.add(id); else bcSelX.delete(id); bcSyncX(); };
window.bcAllX=function(on){ bcSelX.clear(); document.querySelectorAll('.bc-chk').forEach(function(c){ c.checked=on; if(on) bcSelX.add(c.getAttribute('data-id')); }); bcSyncX(); };
window.bcSyncX=function(){ var el=$('bc-count'); if(el) el.textContent=bcSelX.size+' produk dipilih'; var all=$('bc-all'); if(all){ var total=document.querySelectorAll('.bc-chk').length; all.checked=total>0&&bcSelX.size===total; } };
window.bcPreviewX=async function(){
  var t=($('b-text')||{}).value||''; if(!t&&!bcSelX.size){showToast('Isi pesan atau pilih produk dulu.');return;}
