 snStat+'</div>'+
 (sn.enabled?'<div class="card"><h3>VCC Supplier (Senn AutoOrder)</h3><table><tr><th>Saldo Deposit</th><th>Ambang Peringatan</th><th>Status</th><th></th></tr><tr><td style="font-weight:600">'+(sn.deposit==null?'—':rp(sn.deposit))+'</td><td>'+rp(sn.low_threshold)+'</td><td>'+(sn.error?'<span class="badge b-cancelled">'+esc(sn.error)+'</span>':(sn.low?'<span class="badge b-cancelled">Rendah</span>':'<span class="badge b-paid">Sehat</span>'))+'</td><td style="text-align:right"><a href="https://t.me/vccsenna_bot" target="_blank" class="btn sm" style="text-decoration:none">Top Up via Bot ↗</a></td></tr></table><p style="color:var(--muted);font-size:12px;margin-top:10px">Deposit dipotong otomatis Rp1.000 setiap kartu terbit. Pengisian saldo hanya lewat bot @vccsenna_bot (QRIS) — API tidak menyediakan top-up otomatis.</p></div>':'')+
