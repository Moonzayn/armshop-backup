// ---- QRIS webhook (public, signature-validated) ----
app.post('/webhook/qris', async (req, res) => {
  try {
    const { order_id, status, signature } = req.body || {};
    const st = String(status || '').toUpperCase();
    // ---- topup saldo (TP-xxx) ----
    if (order_id && String(order_id).startsWith('TP-')) {
      if (st === 'PAID' || st === 'SUCCESS' || st === 'SETTLED') {
        const t = store.walletGetTopup(order_id);
        // signature wajib cocok (wallet = uang) — kalau topup punya signature, webhook harus menyertakan yang cocok
        if (!t || (t.signature && (!signature || t.signature !== signature))) return res.status(200).send('OK');
        if (store.walletCreditTopup(order_id) && global._bot) {
          global._bot.telegram.sendMessage(t.user_id,
            `💰 <b>Isi saldo ${rp(t.amount)} BERHASIL!</b>\n\n<i>Saldo siap dipakai belanja.</i>`,
            { parse_mode: 'HTML' }).catch(() => {});
        }
      } else if ((st === 'EXPIRED' || st === 'CANCELLED')) {
        store.walletSetTopupStatus(order_id, 'expired');
      }
      return res.status(200).send('OK');
    }
    // ---- order produk ----
    const o = order_id ? store.getOrder(order_id) : null;
    // validasi signature cegah fake webhook
    if (!o || (o.signature && signature && o.signature !== signature)) return res.status(200).send('OK');
    if ((st === 'PAID' || st === 'SUCCESS') && o.status !== 'paid') {
      const { fulfillOrder } = require('./bot');
      if (global._bot) await fulfillOrder(global._bot, order_id, req.body.payment_date || new Date().toISOString());
    } else if (st === 'EXPIRED' && o.status === 'pending') {
      store.setOrderStatus(order_id, 'expired');
    }
  } catch (e) { console.error('[webhook]', e.message); }
  res.status(200).send('OK'); // selalu 200 agar tidak di-retry
});

const auth = (req, res, next) => {
  const t = (req.headers.cookie || '').split(';').map(s => s.trim()).find(s => s.startsWith('sess='));
  if (t && sessions.has(t.slice(5))) return next();
  if (req.path.startsWith('/api/')) return res.status(401).json({ error: 'unauthorized' });
  return res.redirect('/login');
};

app.get('/login', (req, res) => res.send(LOGIN_HTML));
app.post('/api/login', (req, res) => {
  if (req.body.password === process.env.ADMIN_PASSWORD) {
    const t = crypto.randomBytes(24).toString('hex');
    sessions.add(t);
    res.setHeader('Set-Cookie', `sess=${t}; HttpOnly; SameSite=Lax; Path=/; Max-Age=86400`);
    return res.json({ ok: true });
  }
  res.status(401).json({ error: 'Password salah' });
});
app.post('/api/logout', (req, res) => {
  const t = (req.headers.cookie || '').split(';').map(s => s.trim()).find(s => s.startsWith('sess='));
  if (t) sessions.delete(t.slice(5));
  res.json({ ok: true });
});

/* ===== Storefront publik (armshop.my.id) =====
   Semua produk aktif ditampilkan di etalase web.
   Katakan mau mengecualikan kategori tertentu? Tambahkan id-nya di Set di bawah. */
const STOREFRONT_BLOCKED_CATS = new Set([
  'cat-5819de', // VCC
  'cat-a1f78f', // Akun Murah
  'cat-4e7c36', // Gmail Education
  'cat-1cf27b', // Jasa 2FA Gmail
  'ai_tools',   // AI & Productivity (refill/akun)
  'cat-c70404', // VPN (akun shared)
  'streaming', 'games', 'design',
]);
function storefrontSlug(name, id) {
  const base = String(name || '').toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '').slice(0, 60);
  return (base || 'produk') + '-' + String(id).toLowerCase();
}
// ---- harga promo (setting flash_sale, sama seperti bot) ----
function sfPromoCfg() { try { return JSON.parse(store.getSetting('flash_sale', '') || 'null'); } catch (e) { return null; } }
function sfPromoPrice(pid) {
  const c = sfPromoCfg();
  if (!c || !c.active || !c.items) return 0;
  const now = Date.now();
  if (c.starts_at && new Date(c.starts_at).getTime() > now) return 0;
  if (c.ends_at && new Date(c.ends_at).getTime() <= now) return 0;
  const v = Number(c.items[pid]);
  return v > 0 ? v : 0;
}

app.get('/api/storefront', (req, res) => {
  try {
    const cats = store.categories(true).filter(c => !STOREFRONT_BLOCKED_CATS.has(c.id));
    const catIds = new Set(cats.map(c => c.id));
    const stockMap = {};
    for (const r of store.db.prepare('SELECT product_id, COUNT(*) AS n FROM stock WHERE is_used=0 GROUP BY product_id').all()) stockMap[r.product_id] = r.n;
    const soldMap = {};
    for (const r of store.db.prepare("SELECT product_id, COUNT(*) AS n FROM orders WHERE status IN ('paid','delivered') GROUP BY product_id").all()) soldMap[r.product_id] = r.n;
    const products = store.allProducts()
      .filter(p => p.is_active && catIds.has(p.category_id) && (p.type !== 'vcc' || (p.senna_product_id && senna.enabled())))
      .map(p => {
        const desc = String(p.description || '').trim();
        const firstLine = (desc.split('\n').map(s => s.trim()).find(s => s.length > 10) || p.name).slice(0, 110);
        const includes = desc.split('\n').map(s => s.trim())
          .filter(s => /^(✅|✔|•|-|\*|✨|⚡|🔥)/.test(s))
          .map(s => s.replace(/^(✅|✔|•|-|\*|✨|⚡|🔥)\s*/, ''))
          .filter(s => s.length > 2 && s.length < 90).slice(0, 6);
        const stockN = stockMap[p.id] || 0;
        const isDigital = p.type === 'digital';
        const isVcc = p.type === 'vcc' && !!p.senna_product_id;
        const stock = isVcc
          ? { status: 'in' }
          : isDigital
          ? (stockN >= 4 ? { status: 'in', count: stockN } : stockN >= 1 ? { status: 'low', count: stockN } : { status: 'preorder' })
          : { status: 'in' };
        const promoP = sfPromoPrice(p.id);
        return {
          id: p.id,
          slug: storefrontSlug(p.name, p.id),
          name: p.name,
          category: p.category_id,
          tagline: firstLine,
          description: desc || p.name,
          price: promoP || p.price,
          originalPrice: promoP ? p.price : null,
          tosText: String(p.tos_text || ''),
          sold: soldMap[p.id] || 0,
          stock,
          delivery: isVcc
            ? { type: 'instant', label: 'Terbit otomatis', eta: 'kartu terbit otomatis setelah pembayaran terkonfirmasi' }
            : isDigital
            ? { type: 'instant', label: 'Pengiriman otomatis', eta: 'dalam hitungan detik setelah pembayaran' }
            : { type: 'manual', label: 'Diproses admin', eta: 'setelah pembayaran terkonfirmasi' },
          includes,
          faqs: [
            { q: 'Bagaimana cara memesan?', a: 'Tambahkan produk ke keranjang, lanjutkan ke checkout di halaman ini, lalu bayar langsung dengan QRIS di halaman pembayaran. Setelah pembayaran terkonfirmasi, pesananmu diteruskan ke admin untuk diproses.' },
            { q: 'Bagaimana produk dikirim?', a: isVcc ? 'Kartu (nomor, masa berlaku, CVV) terbit otomatis dan tampil di halaman status pesanan setelah pembayaran terkonfirmasi.' : isDigital ? 'Produk digital dikirim otomatis setelah pembayaran terkonfirmasi.' : 'Produk ini diproses manual oleh admin setelah pembayaran terkonfirmasi; kamu akan dihubungi lewat WhatsApp/email yang kamu isi saat checkout.' },
            { q: 'Kalau ada kendala dengan pesanan saya?', a: 'Hubungi admin lewat bot Telegram @lacukbot dengan menyertakan kode pesananmu — kami bantu sampai selesai.' },
          ],
          tags: String(p.name).toLowerCase().split(/[^a-z0-9]+/).filter(w => w.length > 2),
          createdAt: p.created_at || null,
        };
      });
    const usedCatIds = new Set(products.map(p => p.category));
    res.json({
      categories: cats.filter(c => usedCatIds.has(c.id)).map(c => ({ id: c.id, name: c.name })),
      products,
    });
  } catch (e) {
    res.status(500).json({ error: e.message });
  }
});


