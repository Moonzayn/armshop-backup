// ---- bulk import produk via XLSX ----
// Kolom: name | price | type(digital/manual) | category | description | photo_url | stock (kode dipisah ";")
app.post('/api/import-products', upload.single('file'), (req, res) => {
  try {
    if (!req.file) return res.status(400).json({ error: 'File tidak ditemukan' });
    const wb = XLSX.readFile(req.file.path);
    const rows = XLSX.utils.sheet_to_json(wb.Sheets[wb.SheetNames[0]]);
    fs.unlinkSync(req.file.path);
    let added = 0, skipped = 0;
    const newNames = [];
    const insProd = store.db.prepare(`INSERT OR IGNORE INTO products(id,category_id,name,description,price,type,photo_url,is_active,sort) VALUES(?,?,?,?,?,?,?,1,?)`);
    const insCat = store.db.prepare('INSERT OR IGNORE INTO categories(id,name,sort) VALUES(?,?,?)');
    const insStock = store.db.prepare('INSERT INTO stock(product_id,content) VALUES(?,?)');
    const tx = store.db.transaction((rs) => {
      rs.forEach((r, i) => {
        const name = String(r.name || '').trim();
        if (!name) { skipped++; return; }
        let catId = '';
        const catName = String(r.category || '').trim();
        if (catName) {
          catId = 'cat-' + catName.toLowerCase().replace(/[^a-z0-9]+/g, '-').slice(0, 30);
          insCat.run(catId, catName, 99);
        }
        const pid = 'PRD-' + crypto.randomBytes(4).toString('hex').toUpperCase();
        insProd.run(pid, catId, name, String(r.description || ''), Number(r.price) || 0,
          String(r.type || 'digital').toLowerCase() === 'manual' ? 'manual' : 'digital',
          String(r.photo_url || ''), i);
        const codes = String(r.stock || '').split(';').map(s => s.trim()).filter(Boolean);
        codes.forEach(c => insStock.run(pid, c));
        added++;
        newNames.push(name);
      });
    });
    tx(rows);
    if (added) notify.announceImport(added, skipped, newNames);
    res.json({ ok: true, added, skipped, total: rows.length });
  } catch (e) { res.status(400).json({ error: 'Gagal membaca file: ' + e.message }); }
});

